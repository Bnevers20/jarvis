# ══════════════════════════════════════════════════════════════════
# JARVIS — environment variables (copy to apps/web/.env.local for dev,
# and set in the Vercel project for production). ALL secrets are
# server-side only. Never expose keys with NEXT_PUBLIC_ unless noted.
# ══════════════════════════════════════════════════════════════════

# ── The brain (needed Day 1) ──────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Supabase ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-only: node dispatch, cron, audit writes

# ── Embeddings for pgvector memory (DECISION #1 — pick one) ───────
# Voyage (recommended): voyage-3-lite → vector(512)
VOYAGE_API_KEY=
# ...or Supabase gte-small (free, vector(384)) — no key, runs in an edge function
EMBEDDING_PROVIDER=voyage            # voyage | gte-small | openai

# ── Email alerts (already in use elsewhere) ──────────────────────
RESEND_API_KEY=
NOTIFY_EMAIL=                        # where JARVIS emails you alerts/briefings

# ── Web push (proactive engine) ──────────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ── Voice (Week 2 — not needed to start) ─────────────────────────
NEXT_PUBLIC_PICOVOICE_ACCESS_KEY=    # Porcupine wake word (client)
DEEPGRAM_API_KEY=                    # streaming STT
ELEVENLABS_API_KEY=                  # butler TTS
ELEVENLABS_VOICE_ID=

# ── Google (calendar + gmail tools, Days 4-6) ────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ── Tesla Fleet API (later — once the car is owned) ──────────────
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_REDIRECT_URI=

# ── App ───────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
OWNER_EMAIL=                         # single-user lock: only this account may sign in
